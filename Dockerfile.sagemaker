FROM 763104351884.dkr.ecr.us-east-1.amazonaws.com/pytorch-training:2.5.1-gpu-py311-cu124-ubuntu22.04-sagemaker-v1.23

WORKDIR /opt/ml

# Base PyTorch (ensure compatible with PyG wheels).
RUN pip install --no-cache-dir \
    torch==2.5.1 \
    torchvision==0.20.1 \
    torchaudio==2.5.1

# PyTorch Geometric C++ extensions (prebuilt wheels).
RUN pip install --no-cache-dir \
    torch-scatter \
    torch-sparse \
    torch-cluster \
    torch-spline-conv \
    -f https://data.pyg.org/whl/torch-2.5.1+cu124.html

# PyG + temporal layers.
RUN pip install --no-cache-dir \
    torch-geometric \
    torch-geometric-temporal

COPY requirements-sagemaker.txt /opt/ml/requirements/requirements-sagemaker.txt
RUN pip install --no-cache-dir -r /opt/ml/requirements/requirements-sagemaker.txt
